{
  "identifier": "main",
  "description": "Only bundled main window can manage explicit local agent connections and bindings.",
  "local": true,
  "windows": [
    "main"
  ],
  "platforms": [
    "windows"
  ],
  "permissions": [
    "allow-get-desktop-settings",
    "allow-set-desktop-settings",
    "allow-agent-get-status",
    "allow-agent-discover-connection",
    "allow-agent-set-connection",
    "allow-agent-remove-connection",
    "allow-agent-login",
    "allow-agent-logout",
    "allow-agent-list-vaults",
    "allow-select-local-directory",
    "allow-agent-create-binding",
    "allow-agent-pause-binding",
    "allow-agent-resume-binding",
    "allow-agent-list-files",
    "allow-agent-download-entry",
    "allow-agent-release-entry",
    "allow-agent-list-problems",
    "allow-agent-retry-problem",
    "allow-agent-set-mode",
    "allow-agent-get-rules",
    "allow-agent-set-rules",
    "allow-agent-detach-binding",
    "allow-agent-export-recovery",
    "allow-agent-list-history",
    "allow-agent-list-activity",
    "allow-agent-list-trash",
    "allow-agent-restore-entry",
    "allow-agent-notification-settings",
    "allow-agent-set-notifications"
  ]
}
