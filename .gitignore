# 任务隔离工作树（不进版本库，见 AGENTS.md）
/.worktrees/

# Python 本地检查缓存
__pycache__/
*.pyc

# Rust 构建产物
/target/
**/target/

# 前端依赖与构建产物
node_modules/
**/node_modules/
dist/

# 本地运行数据、测试卷与生成代码
/artifacts/
/var/

# 交叉编译缓存（rustup 工具链、cargo 注册表、cargo-xwin 的 MSVC CRT/SDK）
/.cache/

# Nix 构建输出符号链接（nix build/develop 在仓库根产生 result、result-*）
/result
/result-*

# 环境与凭据
.env
.env.local
